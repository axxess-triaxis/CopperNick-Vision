# Gemini API key, from Google AI Studio (https://aistudio.google.com/apikey).
# Non-secret in the sense that it's not committed here -- treat it as a real secret locally.
GEMINI_API_KEY=

# Google Earth Engine -- a registered Earth Engine project ID. Requires
# ee.Authenticate() to have been run once locally (opens a browser flow).
GEE_PROJECT_ID=

# Gemini model used for risk-assessment reasoning.
COPPERNICK_GEMINI_MODEL=gemini-3.8-flash
